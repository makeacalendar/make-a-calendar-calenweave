{
  "name": "@makeacalendar/calenweave",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./core": "./src/core/mod.ts",
    "./holidays": "./src/holidays.ts",
    "./business": "./src/business.ts",
    "./payroll": "./src/payroll.ts",
    "./shifts": "./src/shifts.ts",
    "./fiscal": "./src/fiscal.ts",
    "./recurrence": "./src/recurrence.ts",
    "./cron": "./src/cron.ts",
    "./converters": "./src/converters.ts",
    "./rendering": "./src/rendering.ts",
    "./exports": "./src/exports.ts",
    "./composition": "./src/composition.ts"
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check mod.ts",
    "test": "deno test --no-check tests/calendar.test.ts",
    "doc": "deno doc --lint mod.ts",
    "publish:dry-run": "deno publish --dry-run",
    "examples": "deno run examples/smoke.ts"
  },
  "compilerOptions": { "strict": true, "noImplicitOverride": true },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "deno.json",
      "jsr.json",
      "mod.ts",
      "src/**/*.ts",
      "docs/**/*.md"
    ]
  }
}
